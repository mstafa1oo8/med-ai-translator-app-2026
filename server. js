
import express from "express";
import rateLimit from "express-rate-limit";
import OpenAI from "openai";

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json({ limit: "100kb" }));

app.use(rateLimit({
  windowMs: 60 * 1000,
  limit: 20,
  message: { error: "طلبات كثيرة، حاول بعد دقيقة." }
}));

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.post("/api/translate", async (req, res) => {
  try {
    const { text, sourceLang, targetLang, task } = req.body;

    if (!text || typeof text !== "string") {
      return res.status(400).json({
        error: "يرجى إدخال النص."
      });
    }

    if (text.length > 12000) {
      return res.status(400).json({
        error: "النص أطول من الحد المسموح."
      });
    }

    const response = await openai.responses.create({
      model: "gpt-5.5",
      instructions: `
أنت مترجم طبي متخصص.
ترجم النص بدقة عالية.
حافظ على المصطلحات الطبية ومعناها العلمي.
لا تحذف أي معلومة من النص.
حافظ على الأرقام والجرعات والوحدات.
إذا كان النص غامضاً فلا تخترع معلومات.
أخرج الترجمة فقط دون مقدمات.
      `,
      input: `
نوع المهمة: ${task || "ترجمة طبية"}
لغة المصدر: ${sourceLang || "تلقائي"}
اللغة المطلوبة: ${targetLang || "العربية"}

النص:
${text}
      `
    });

    res.json({
      result: response.output_text
    });

  } catch (error) {
    console.error("Translation error:", error.message);

    res.status(500).json({
      error: "تعذرت الترجمة حالياً. تحقق من إعدادات الخادم ومفتاح API."
    });
  }
});

app.use(express.static("."));

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
